# ============================================
# .htaccess para erun.es - FRONT CONTROLLER
# ============================================

Options -Indexes -MultiViews
RewriteEngine On

# Forzar HTTPS (mejorado)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L,NE]
# ============================================
# QUITAR WWW
# ============================================
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ============================================
# PROTEGER ACCESO DIRECTO A DIRECTORIOS SENSIBLES
# ============================================
RewriteRule ^config/.*$ - [F,L]
RewriteRule ^includes/.*$ - [F,L]
RewriteRule ^logs/.*$ - [F,L]
RewriteRule ^cache/.*$ - [F,L]
RewriteRule ^tmp/.*$ - [F,L]

# ============================================
# BLOQUEAR REPOSITORIOS Y ARCHIVOS OCULTOS
# ============================================
RewriteRule ^(?:\.git|\.git-antiguo)(?:/|$) - [F,L,NC]

# Bloquear archivos y directorios que empiezan por punto,
# permitiendo .well-known para certificados SSL
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]

# ============================================
# FRONT CONTROLLER
# ============================================
# Las rutas base de las áreas coinciden con directorios físicos y deben
# resolverse mediante routes.php igual que sus respectivos dashboards.
RewriteRule ^(?:admin|periodista|usuario|privado)/?$ index.php [QSA,L]

# Si el archivo o directorio existe, servirlo directamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule .* - [L]

# Todo lo demás se procesa por el front controller
RewriteRule ^(.*)$ index.php [QSA,L]

# ============================================
# PROTEGER ARCHIVOS SENSIBLES POR EXTENSIÓN
# ============================================
<FilesMatch "^(?!robots\.txt$).+\.(ini|log|sh|sql|bak(?:[-.].*)?|txt|md|json|lock|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>

# ============================================
# CACHÉ DE RECURSOS ESTÁTICOS
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:jpe?g|png|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# ============================================
# HEADERS DE SEGURIDAD (UNIFICADO)
# ============================================
<IfModule mod_headers.c>
    # Cabeceras básicas de seguridad
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    Header always set Strict-Transport-Security "max-age=15768000; includeSubDomains"
    
    # Content Security Policy (CSP)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tiny.cloud https://*.tinymce.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; img-src 'self' data: https:; font-src 'self' data: https://cdnjs.cloudflare.com; connect-src 'self' https://*.epdata.es; frame-src 'self' https://www.youtube.com https://player.vimeo.com https://www.google.com https://embed.epdata.es https://*.epdata.es; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';"
    
    # Ocultar información del servidor
    Header unset X-Powered-By

    # No propagar la URL que contiene el token de recuperación.
    Header always set Referrer-Policy "no-referrer" "expr=%{THE_REQUEST} =~ m#\\s/+((public/)?resetear_password(\\.php)?)([?\\s])#"
</IfModule>

# ============================================
# PÁGINAS DE ERROR PERSONALIZADAS
# ============================================
ErrorDocument 404 /public/404.php
ErrorDocument 403 /public/403.php
ErrorDocument 500 /public/500.php
